{
  "name": "timepin-s4",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build apps/web --base ./",
    "web": "vite apps/web --host 127.0.0.1",
    "desktop": "electron apps/desktop",
    "prebuild": "node prepare-web.mjs",
    "preweb": "node prepare-web.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.3.4",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
